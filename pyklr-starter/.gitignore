# ~850 third-party files (this is what produced the 605-file diff in GitHub Desktop).
venv/
.venv/
__pycache__/
*.pyc

# Build and debug logs
xcodebuild.log
xcodebuild_error_*.log

# Local expect/python helper scripts
*.exp

# Editing backups
*.bak-*
