{
  "name": "pyklr",
  "version": "0.1.0",
  "private": true,
  "description": "PYKLR — Meet players. Start matches. (monorepo root)",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "mobile": "pnpm --filter @pyklr/mobile dev",
    "admin": "pnpm --filter @pyklr/admin dev",
    "db:reset": "pnpm --filter @pyklr/supabase db:reset",
    "db:push": "pnpm --filter @pyklr/supabase db:push",
    "db:gen-types": "pnpm --filter @pyklr/supabase gen:types",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
